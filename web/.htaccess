# Guru Kripa Astro Science — Flutter web site on Cloudways (Apache).

# Open the Flutter site even if Cloudways' default index.php is present.
DirectoryIndex index.html index.php

# Correct content types for Flutter's rendering engine and fonts.
AddType application/wasm .wasm
AddType application/javascript .mjs
AddType font/ttf .ttf

# Compress text-based files.
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain application/javascript application/json application/wasm image/svg+xml font/ttf
</IfModule>

<IfModule mod_headers.c>
  # Entry files must always be re-checked, so a new deployment shows up
  # immediately instead of an old cached copy.
  <FilesMatch "^(index\.html|flutter_bootstrap\.js|flutter\.js|main\.dart\.js|manifest\.json|version\.json)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Engine, fonts and images rarely change: cache them for a week.
  <FilesMatch "\.(wasm|ttf|otf|png|jpg|jpeg|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=604800"
  </FilesMatch>
</IfModule>

# Single-page site: any unknown address shows the home page.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
